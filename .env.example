# Public site settings
NEXT_PUBLIC_SITE_URL=https://gharmalak.in
# WhatsApp Business number, country code first, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Razorpay payment link or payment page for the Rs 499 membership
NEXT_PUBLIC_RAZORPAY_PAYMENT_LINK=
# Gharmalak Check (Pune test): Razorpay payment links for the two test prices. Empty = ask on WhatsApp.
NEXT_PUBLIC_CHECK_PAYMENT_LINK_99=
NEXT_PUBLIC_CHECK_PAYMENT_LINK_299=
# Razorpay link for a buyer's call with a verified owner (Rs 499)
NEXT_PUBLIC_CHECK_PAYMENT_LINK_CALL=

# Server-only settings
# MySQL on Hostinger: host 127.0.0.1, port 3306. Leave DB_NAME empty to store data in data/store.json (testing only).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Founder desk login. Use a long password.
DESK_PASSWORD=
# Random string, at least 32 characters, used to sign the desk login cookie
SESSION_SECRET=
# Razorpay webhook secret (Dashboard > Webhooks), event payment_link.paid / payment.captured
RAZORPAY_WEBHOOK_SECRET=
